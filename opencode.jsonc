{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/google/gemini-3.8-flash",
  "small_model": "openrouter/google/gemini-3.8-flash",
  "enabled_providers": [
    "openrouter"
  ],
  "provider": {
    "openrouter": {
      "name": "OpenRouter",
      "options": {
        "apiKey": "{env:OPENROUTER_HOME_API_KEY}"
      },
      "models": {
        "google/gemini-3.8-flash": { "name": "Gemini 3.8 Flash" },
        "moonshotai/kimi-k2.7-code": { "name": "Kimi K2.7 Code" },
        "qwen/qwen3.8-2.4t-a95b": { "name": "Qwen 3.8 2.4T A95B" },
        "deepseek/deepseek-v4.1-flash": { "name": "DeepSeek V4.1 Flash" },
        "z-ai/glm-5.3": { "name": "GLM 5.3" },
        "z-ai/glm-5.3-flash": { "name": "GLM 5.3 Flash" }
      }
    }
  },
  "mcp": {
    // #107: image pinned by digest — GHCR publishes no version tags for this image
    // (only latest/main/nightly), so :latest is mutable. Digest below = v1.12.2
    // (2026-09-16, commit 85598ba6). Default toolsets kept intentionally (no
    // --toolsets flag): upstream defaults already match the SCRUM set (#106 baseline).
    "GITHUB": {
      "type": "local",
      "command": [
        "docker", "run", "-i", "--rm",
        "-e", "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server@sha256:508a0857ec762b1ab1cece29193345b501fab1dd9d1228a7b617062954cecac6"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "enabled": true
    },
    // AC2 (#83): this second github-mcp-server instance is necessary, not redundant —
    // it authenticates as the separate @devfpittelo identity via
    // {env:GITHUB_TOKEN_CODE_REVIEWER} so @code-reviewer can approve PRs under
    // separation-of-duties (SoD). The primary GITHUB server acts as @fpittelo, and
    // one server instance can only carry one token/identity.
    // #107: same digest pin as GITHUB (v1.12.2); toolsets restricted to
    // context,repos,pull_requests — 32 tools / ~80 KB vs 45 / ~124 KB default
    // (−35% schema, #106 baseline). Review work needs no issues/labels toolsets.
    "GITHUB_CODE_REVIEWER": {
      "type": "local",
      "command": [
        "docker", "run", "-i", "--rm",
        "-e", "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server@sha256:508a0857ec762b1ab1cece29193345b501fab1dd9d1228a7b617062954cecac6",
        "stdio", "--toolsets=context,repos,pull_requests"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN_CODE_REVIEWER}"
      },
      "enabled": true
    },
    // AC1 (#83) toggle pattern: only one Coach environment is active at a time so
    // duplicate tool schemas are not injected into every LLM turn. To switch
    // environments, set "enabled": true on the target and false on the others.
    // #107 image policy: coach tags (dev/qa/latest) are environment promotion tags
    // published by coach repo CI (dev→qa→main); they are the accepted pin level for
    // our own images — do not swap them for floating refs. Server renames: #108.
    "COACH DEV": {
      "type": "local",
      "command": [
        "docker", "run", "-i", "--rm",
        "-e", "INTERVALS_API_KEY",
        "-e", "INTERVALS_ATHLETE_ID",
        "-e", "MCP_TRANSPORT",
        "ghcr.io/fpittelo/coach:dev"
      ],
      "environment": {
        "INTERVALS_API_KEY": "{env:INTERVALS_API_KEY}",
        "INTERVALS_ATHLETE_ID": "{env:INTERVALS_ATHLETE_ID}",
        "MCP_TRANSPORT": "stdio"
      },
      "enabled": true
    },
    "COACH QA": {
      "type": "local",
      "command": [
        "docker", "run", "-i", "--rm",
        "-e", "INTERVALS_API_KEY",
        "-e", "INTERVALS_ATHLETE_ID",
        "-e", "MCP_TRANSPORT",
        "ghcr.io/fpittelo/coach:qa"
      ],
      "environment": {
        "INTERVALS_API_KEY": "{env:INTERVALS_API_KEY}",
        "INTERVALS_ATHLETE_ID": "{env:INTERVALS_ATHLETE_ID}",
        "MCP_TRANSPORT": "stdio"
      },
      "enabled": false
    },
    "COACH MAIN": {
      "type": "local",
      "command": [
        "docker", "run", "-i", "--rm",
        "-e", "INTERVALS_API_KEY",
        "-e", "INTERVALS_ATHLETE_ID",
        "-e", "MCP_TRANSPORT",
        "ghcr.io/fpittelo/coach:latest"
      ],
      "environment": {
        "INTERVALS_API_KEY": "{env:INTERVALS_API_KEY}",
        "INTERVALS_ATHLETE_ID": "{env:INTERVALS_ATHLETE_ID}",
        "MCP_TRANSPORT": "stdio"
      },
      "enabled": false
    },
    "openrouter": {
      "type": "remote",
      "url": "https://mcp.openrouter.ai/mcp",
      "enabled": true
    }
  },
  "permission": {
    // Last matching rule wins: broad rules first, narrow allow/deny rules last.
    "bash": {
      "*": "ask",
      "git *": "allow",
      "docker *": "allow",
      "pytest*": "allow",
      "ruff*": "allow",
      "bash -n *": "allow",
      "python*": "allow",
      "npm*": "allow",
      "node*": "allow",
      "rm -rf /*": "deny",
      "mkfs.*": "deny",
      "dd if=* of=/dev/*": "deny"
    }
  },
  "compaction": {
    "auto": true,
    "tail_turns": 15
  },
  "tool_output": {
    "max_lines": 300,
    "max_bytes": 32768
  },
  "experimental": {
    "mcp_timeout": 30000
  }
}
