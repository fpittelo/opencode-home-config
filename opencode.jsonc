{
  "$schema": "https://opencode.ai/config.json",
  // #149: every OpenCode session launches into the governed Solution Architect
  // persona (agents/architect.md declares mode: primary). The built-in BUILD and
  // PLAN modes are disabled below so the TUI mode switcher offers governed HOME
  // SCRUM agents only.
  "default_agent": "architect",
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    }
  },
  "model": "openrouter/google/gemini-3.8-flash",
  "small_model": "openrouter/google/gemini-3.8-flash",
  "enabled_providers": [
    "openrouter"
  ],
  "provider": {
    "openrouter": {
      "name": "OpenRouter",
      "options": {
        "apiKey": "{env:OPENROUTER_HOME_API_KEY}"
      },
      "models": {
        "google/gemini-3.8-flash": { "name": "Gemini 3.8 Flash" },
        "moonshotai/kimi-k2.7-code": { "name": "Kimi K2.7 Code" },
        "qwen/qwen3.8-2.4t-a95b": { "name": "Qwen 3.8 2.4T A95B" },
        "openai/gpt-6-luna": { "name": "GPT-6 Luna" },
        "deepseek/deepseek-v4.1-flash": { "name": "DeepSeek V4.1 Flash" },
        "z-ai/glm-5.3": { "name": "GLM 5.3" },
        "z-ai/glm-5.3-flash": { "name": "GLM 5.3 Flash" }
      }
    }
  },
  "mcp": {
    // #109: native binary transport (MADR-0002 decision point 3) — replaces the
    // former `docker run` of ghcr.io/github/github-mcp-server@sha256:508a0857…
    // (v1.12.2, commit 85598ba6 — same build as the installed binary). The binary
    // is installed by install.sh at ~/.local/bin/github-mcp-server, version-pinned
    // + SHA256-verified against the release checksums file. Native startup is
    // milliseconds vs ~0.6 s per container spawn (2x per session, #106 baseline).
    // Default toolsets kept intentionally (no --toolsets flag): upstream defaults
    // already match the SCRUM set (#106 baseline).
    "GITHUB": {
      "type": "local",
      "command": [
        "{env:HOME}/.local/bin/github-mcp-server",
        "stdio"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "enabled": true
    },
    // AC2 (#83): this second github-mcp-server instance is necessary, not redundant —
    // it authenticates as the separate @devfpittelo identity via
    // {env:GITHUB_TOKEN_CODE_REVIEWER} so @code-reviewer can approve PRs under
    // separation-of-duties (SoD). The primary GITHUB server acts as @fpittelo, and
    // one server instance can only carry one token/identity.
    // #109: native binary transport (same pinned build as GITHUB, installed by
    // install.sh). #107 toolset restriction preserved on the binary transport:
    // --toolsets=context,repos,pull_requests — 32 tools / ~80 KB vs 45 / ~124 KB
    // default (−35% schema, #106 baseline). Review work needs no issues/labels
    // toolsets.
    "GITHUB_CODE_REVIEWER": {
      "type": "local",
      "command": [
        "{env:HOME}/.local/bin/github-mcp-server",
        "stdio", "--toolsets=context,repos,pull_requests"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN_CODE_REVIEWER}"
      },
      "enabled": true
    },
    // AC1 (#83) toggle pattern: only one Coach environment is active at a time so
    // duplicate tool schemas are not injected into every LLM turn. To switch
    // environments, set "enabled": true on the target and false on the others.
    // #107 image policy: coach tags (dev/qa/latest) are environment promotion tags
    // published by coach repo CI (dev→qa→main); they are the accepted pin level for
    // our own images — do not swap them for floating refs.
    // #108: servers renamed to space-free COACH_DEV/COACH_QA/COACH_MAIN so MCP tool
    // permission patterns are unambiguous (tools are namespaced <SERVER>_<tool>).
    // SoD (#83 pattern extended, #150): Coach MCP is @coach-only. The root
    // permission object below carries the global default-deny baseline
    // (COACH_*_*: deny) covering built-in subagents (explore, general, task)
    // and any unconfigured persona; every SCRUM agent re-states the denies
    // explicitly in agents/*.md, and agents/coach.md holds the sole allow
    // whitelist. Every agent except @architect/@coach denies openrouter_* tools.
    "COACH_DEV": {
      "type": "local",
      "command": [
        "docker", "run", "-i", "--rm",
        "-e", "INTERVALS_API_KEY",
        "-e", "INTERVALS_ATHLETE_ID",
        "-e", "MCP_TRANSPORT",
        "ghcr.io/fpittelo/coach:dev"
      ],
      "environment": {
        "INTERVALS_API_KEY": "{env:INTERVALS_API_KEY}",
        "INTERVALS_ATHLETE_ID": "{env:INTERVALS_ATHLETE_ID}",
        "MCP_TRANSPORT": "stdio"
      },
      "enabled": true
    },
    "COACH_QA": {
      "type": "local",
      "command": [
        "docker", "run", "-i", "--rm",
        "-e", "INTERVALS_API_KEY",
        "-e", "INTERVALS_ATHLETE_ID",
        "-e", "MCP_TRANSPORT",
        "ghcr.io/fpittelo/coach:qa"
      ],
      "environment": {
        "INTERVALS_API_KEY": "{env:INTERVALS_API_KEY}",
        "INTERVALS_ATHLETE_ID": "{env:INTERVALS_ATHLETE_ID}",
        "MCP_TRANSPORT": "stdio"
      },
      "enabled": false
    },
    "COACH_MAIN": {
      "type": "local",
      "command": [
        "docker", "run", "-i", "--rm",
        "-e", "INTERVALS_API_KEY",
        "-e", "INTERVALS_ATHLETE_ID",
        "-e", "MCP_TRANSPORT",
        "ghcr.io/fpittelo/coach:latest"
      ],
      "environment": {
        "INTERVALS_API_KEY": "{env:INTERVALS_API_KEY}",
        "INTERVALS_ATHLETE_ID": "{env:INTERVALS_ATHLETE_ID}",
        "MCP_TRANSPORT": "stdio"
      },
      "enabled": false
    },
    "openrouter": {
      "type": "remote",
      "url": "https://mcp.openrouter.ai/mcp",
      "enabled": true
    }
  },
  "permission": {
    // #150 (AC1): global default-deny baseline for the Coach MCP namespaces —
    // built-in subagents (explore, general, task) and any unconfigured persona
    // inherit zero Coach MCP access. @coach re-allows in agents/coach.md and
    // every SCRUM agent re-states the deny explicitly (defense in depth).
    "COACH_DEV_*": "deny",
    "COACH_QA_*": "deny",
    "COACH_MAIN_*": "deny",
    // #158 (MADR-0004): allow-by-default bash posture with catastrophic-deny
    // guardrails (PO directive 2026-10-03) — supersedes the #86-era ask-default +
    // short allowlist. Last matching rule wins: broad rules first, deny rules
    // LAST. Compound commands (&&, ;, |) are split and EVERY segment is
    // evaluated, so one denied segment blocks the whole command. Three tiers:
    // (1) "*": allow — routine work runs unprompted; (2) ask-tier — a single
    // checkpoint for destructive-but-recoverable ops; (3) hard deny tail —
    // catastrophic / irreversible / bypass commands. See docs/adr/0004-*.
    "bash": {
      "*": "allow",
      // --- ask-tier (single checkpoint; catastrophic variants hard-denied below) ---
      "rm *": "ask",
      "pip install*": "ask",
      "npm install -g*": "ask",
      "npm i -g*": "ask",
      "kill*": "ask",
      "pkill*": "ask",
      "killall*": "ask",
      "chmod *": "ask",
      "chown *": "ask",
      "systemctl*": "ask",
      // --- hard deny tail (catastrophic / irreversible / bypass) ---
      "sudo*": "deny",
      "rm -rf /*": "deny",
      "rm -fr /*": "deny",
      "rm -rf /": "deny",
      "rm -rf ~*": "deny",
      "rm -rf $HOME*": "deny",
      "rm -rf ${HOME}*": "deny",
      "mkfs*": "deny",
      "dd *of=/dev/*": "deny",
      "shred*": "deny",
      "wipefs*": "deny",
      "blockdev*": "deny",
      "fdisk*": "deny",
      "sfdisk*": "deny",
      "gdisk*": "deny",
      "parted*": "deny",
      "truncate * /dev/*": "deny",
      "* > /dev/sd*": "deny",
      "* > /dev/nvme*": "deny",
      "* > /dev/mmcblk*": "deny",
      "* > /dev/vd*": "deny",
      "* > /dev/hd*": "deny",
      "mv * /dev/sd*": "deny",
      "mv * /dev/nvme*": "deny",
      "mv * /dev/mmcblk*": "deny",
      "shutdown*": "deny",
      "reboot*": "deny",
      "halt*": "deny",
      "poweroff*": "deny",
      "systemctl poweroff*": "deny",
      "systemctl reboot*": "deny",
      "systemctl halt*": "deny",
      "crontab*": "deny",
      "systemd-run*": "deny",
      "chmod -R * /*": "deny",
      "chown -R * /*": "deny",
      "find * -delete*": "deny",
      "find * -exec rm*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git filter-branch*": "deny",
      "git filter-repo*": "deny",
      "git clean*": "deny",
      "git reset --hard*": "deny",
      "curl*": "deny",
      "wget*": "deny",
      "bash -c *": "deny",
      "sh *": "deny",
      "python* -c*": "deny",
      "node -e*": "deny",
      "node --eval*": "deny",
      "perl -e*": "deny",
      "ruby -e*": "deny",
      "printenv*": "deny",
      "env": "deny",
      "cat /proc/*/environ*": "deny",
      // #167 (MADR-0004 Security Considerations): file-centric secret denies —
      // block any command referencing a credential filename (closes the
      // head/rg/strings read-family bypass; "*.env*" subsumes the #158
      // cat-specific deny; "*token*" skipped — over-matches command-agnostically).
      "*.env*": "deny",
      "*.pem*": "deny",
      "*.key*": "deny"
    }
  },
  "compaction": {
    "auto": true,
    "tail_turns": 15
  },
  "tool_output": {
    "max_lines": 300,
    "max_bytes": 32768
  },
  "experimental": {
    "mcp_timeout": 30000
  }
}
